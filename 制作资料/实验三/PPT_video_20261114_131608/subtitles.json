    "font": "Microsoft YaHei",
    "font_size": 56,
    "style": "Light",
    "source_tts_start": 6.8875,
    "source_tts_end": 9.95
  },
  {
    "index": 73,
    "slide": 14,
    "start": 204.087794,
    "end": 206.110917,
    "text": "这是有限规则下的样例核验，",
    "estimated_width_px": 728.0,
    "position": [
      1280,
