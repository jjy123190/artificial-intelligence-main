{
  "name": "equity-reasoning-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json",
    "test:routes": "node scripts/check-routes.mjs",
    "test:notation": "node scripts/check-rule-notation.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "cytoscape": "^3.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.1.0"
  }
}
