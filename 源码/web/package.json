{
  "name": "equity-reasoning-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json",
    "test:routes": "node scripts/check-routes.mjs",
    "test:notation": "node scripts/check-rule-notation.mjs",
    "test:api": "node scripts/check-api.mjs",
    "test:lab03": "node scripts/check-lab03.mjs",
    "test:wording": "node scripts/check-display-text.mjs",
    "test:wording-browser": "node scripts/check-display-browser.mjs",
    "test:browser": "node scripts/check-lab03-browser.mjs",
    "test:workbench": "node scripts/check-workbench-browser.mjs",
    "test:lab04": "node scripts/check-lab04-browser.mjs",
    "test:lab04-contract": "node scripts/check-lab04-contract.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "cytoscape": "^3.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/cytoscape": "^3.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.5"
  }
}
